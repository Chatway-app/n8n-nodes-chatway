{
  "name": "n8n-nodes-chatway",
  "version": "1.0.7",
  "description": "Automate Chatway Live Chat with n8n. Trigger workflows from customer events, manage conversations, send replies, and sync contacts.",
  "license": "MIT",
  "homepage": "https://chatway.app",
  "author": {
    "name": "Chatway",
    "email": "contact@chatway.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chatway-app/n8n-nodes-chatway.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ChatwayApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Chatway/Chatway.node.js",
      "dist/nodes/ChatwayTrigger/ChatwayTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chatway",
    "chatway-live-chat",
    "live-chat",
    "customer-support",
    "customer-service",
    "helpdesk",
    "shared-inbox",
    "workflow-automation",
    "customer-support-automation",
    "chat-automation",
    "webhooks",
    "ai-agent",
    "customer-messaging",
    "contacts"
  ]
}
