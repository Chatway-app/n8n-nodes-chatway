{
  "name": "n8n-nodes-chatway",
  "version": "0.1.0",
  "description": "n8n node for Chatway Live Chat: manage customer support conversations, messages, and contacts",
  "license": "MIT",
  "homepage": "https://github.com/Chatway-app/n8n-nodes-chatway",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chatway",
    "live-chat",
    "customer-support"
  ],
  "author": {
    "name": "Nibir Ahmed",
    "email": "nibirahmed9611@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chatway-app/n8n-nodes-chatway.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ChatwayApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Chatway/Chatway.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
